#!/bin/sh
# ============================================================
# CODEX ATLAS pre-commit hook
#
# Catches three failure modes that have bitten the site:
#  1. Staging a syntactically broken src/js/*.js (sonnet content
#     batches sweeping in a stale checkout — observed twice 2026-05-15).
#  2. Quietly committing a revert that loses recent app-code work
#     (we run a sanity grep for known-required globals after #1 passes).
#  3. Cross-lane commits — staging Lane B (UX) paths AND Lane A
#     (content) paths in the same commit. See 00_meta/LANES.md.
#
# Install:  ln -sf ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
# Bypass (NEVER for routine work):  git commit --no-verify
# ============================================================

set -e

# Resolve repo root so the hook works from any cwd / worktree.
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED_ALL="$(git diff --cached --name-only --diff-filter=ACM)"

# ---------- 3. Cross-lane check (run first; cheapest) ----------
# Lane B owns: src/, index.html, build/lint/linkcheck/fetch python scripts, _assets/
LANE_B="$(printf '%s\n' "$STAGED_ALL" | grep -E '^(src/|index\.html$|build_[^/]+\.py$|lint_yaml\.py$|linkcheck\.py$|fetch_[^/]+\.py$|review_thumbnails\.py$|add_depictions\.py$|_assets/|scripts/|start-atlas\.command$)' || true)"
# Lane A owns: numbered content folders + the auto-regenerated meta files
LANE_A="$(printf '%s\n' "$STAGED_ALL" | grep -E '^(0[1-9]_|1[0-7]_)' || true)"

if [ -n "$LANE_B" ] && [ -n "$LANE_A" ]; then
  echo "" >&2
  echo "✗ pre-commit: cross-lane commit detected." >&2
  echo "" >&2
  echo "  Lane B (UX) paths in stage:" >&2
  printf '%s\n' "$LANE_B" | sed 's/^/    /' >&2
  echo "  Lane A (content) paths in stage:" >&2
  printf '%s\n' "$LANE_A" | sed 's/^/    /' >&2
  echo "" >&2
  echo "  These two lanes commit separately by design — content agents must not" >&2
  echo "  sweep app-code into their batches (twice killed the site 2026-05-15)." >&2
  echo "  See 00_meta/LANES.md." >&2
  echo "" >&2
  echo "  To split: unstage the wrong-lane paths and commit your own lane only." >&2
  echo "    git reset HEAD -- <wrong-lane-path>" >&2
  echo "" >&2
  echo "  Override (only if John explicitly authorised it):" >&2
  echo "    git commit --no-verify" >&2
  exit 1
fi

# Find any staged .js files under src/js/.
STAGED_JS="$(printf '%s\n' "$STAGED_ALL" | grep -E '^src/js/.+\.js$' || true)"

if [ -n "$STAGED_JS" ]; then
  # 1. Syntax check every staged JS file.
  if ! command -v node >/dev/null 2>&1; then
    NODE_BIN="$(ls ~/.local/node/bin/node 2>/dev/null || true)"
    if [ -z "$NODE_BIN" ]; then
      echo "✗ pre-commit: node binary not found. Cannot syntax-check JS." >&2
      echo "  Install node, or bypass once with: git commit --no-verify" >&2
      exit 1
    fi
  else
    NODE_BIN="node"
  fi

  FAILED=""
  for f in $STAGED_JS; do
    # Read the staged version (not the working tree — they can differ).
    # IMPORTANT: pipe via `git show` directly, NOT `echo "$STAGED_CONTENT"` —
    # /bin/sh's `echo` re-interprets backslash escapes (\n, \r, \a, …) in
    # the variable contents, corrupting any JS regex like /[^\n]/ into a
    # literal newline before the closing `]`. This produced a false-positive
    # "Invalid regular expression" failure the first time the hook was run
    # against src/js/alchemy/board.js (2026-05-15, sonnet-edges-v2).
    if ! git show ":$f" | "$NODE_BIN" --check - 2>/tmp/codex-precommit-err; then
      echo "" >&2
      echo "✗ SYNTAX ERROR in staged $f:" >&2
      sed 's/^/    /' /tmp/codex-precommit-err >&2
      FAILED="$FAILED $f"
    fi
  done

  if [ -n "$FAILED" ]; then
    echo "" >&2
    echo "✗ pre-commit: refusing to commit syntactically broken JavaScript." >&2
    echo "  Files:$FAILED" >&2
    echo "" >&2
    echo "  If this is a content batch and you didn't intend to edit app code:" >&2
    echo "    git checkout HEAD -- $FAILED" >&2
    echo "    git add ... (just your content files)" >&2
    echo "    git commit ..." >&2
    echo "" >&2
    echo "  If you really intend the JS change, fix the syntax and re-stage." >&2
    exit 1
  fi

  # 2. Sanity check on src/js/app.js — the canaries below are load-bearing
  #    blocks that have been deleted by parallel-agent commit sweeps before.
  #    If a staged app.js LACKS them, that's almost certainly a stale-revert.
  if printf '%s\n' "$STAGED_JS" | grep -q "^src/js/app.js$"; then
    MISSING=""
    for canary in "VIEWS.astrology" "VIEWS.pantheon" "VIEWS.transmission" "window.selectNode" "VIEWS.alchemy"; do
      # Pipe directly from `git show` — see note above re: /bin/sh `echo`
      # munging backslash escapes inside JS source held in shell variables.
      if ! git show :src/js/app.js | grep -q "$canary"; then
        MISSING="$MISSING $canary"
      fi
    done
    if [ -n "$MISSING" ]; then
      echo "" >&2
      echo "✗ pre-commit: staged src/js/app.js is missing load-bearing blocks:" >&2
      echo "   $MISSING" >&2
      echo "" >&2
      echo "  This looks like a stale-checkout sweep (a content batch committing" >&2
      echo "  an OLD app.js, deleting recent app-code work). Two such sweeps" >&2
      echo "  killed the site on 2026-05-15. Revert with:" >&2
      echo "    git checkout HEAD -- src/js/app.js" >&2
      echo "    git add ... (your real intended files)" >&2
      echo "" >&2
      echo "  If you genuinely meant to delete one of these blocks, bypass with" >&2
      echo "  --no-verify (after explicit confirmation from John)." >&2
      exit 1
    fi
  fi
fi

exit 0
