#!/bin/sh
# ============================================================
# CODEX ATLAS pre-commit hook
#
# Catches six failure modes that have bitten the site:
#  1. Staging a syntactically broken src/js/*.js (sonnet content
#     batches sweeping in a stale checkout — observed twice 2026-05-15).
#  2. Quietly committing a revert that loses recent app-code work
#     (we run a sanity grep for known-required globals after #1 passes).
#  3. Cross-lane commits — staging Lane B (UX) paths AND Lane A
#     (content) paths in the same commit. See 00_meta/LANES.md.
#  4. NEW (TYRANT Phase 2, 2026-05-25, finding #1+#4): wiring-law
#     violations — pre-commit now runs `linkcheck.py --baseline` on
#     Lane A content commits and refuses any NEW dead [[wikilink]]
#     target not already on AUDIT/dead-link-baseline.txt. The
#     existing ~593 dead targets are tolerated as the floor;
#     new ones cannot land.
#  5. NEW (TYRANT Phase 2, 2026-05-25, finding #3+#4): schema-lint
#     gate — `lint_yaml.py --strict` runs on Lane A content commits
#     and refuses any ERROR-level issue (malformed frontmatter,
#     missing required field, unknown type). 29-type coverage now.
#  6. NEW (TYRANT Phase 2, 2026-05-25, finding #5): dup-ID gate —
#     `build_data.py`'s post-commit hard-fail is now PRE-commit.
#     `ATLAS_ALLOW_DUP_ID=1` escape hatch removed (no longer
#     readable from the hook).
#
# Install:  ln -sf ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
# Bypass (NEVER for routine work):  git commit --no-verify
# ============================================================

set -e

# Resolve repo root so the hook works from any cwd / worktree.
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED_ALL="$(git diff --cached --name-only --diff-filter=ACM)"

# ---------- 3. Cross-lane check (run first; cheapest) ----------
# Lane B owns: src/, index.html, build/lint/linkcheck/fetch python scripts, _assets/
LANE_B="$(printf '%s\n' "$STAGED_ALL" | grep -E '^(src/|index\.html$|build_[^/]+\.py$|lint_yaml\.py$|linkcheck\.py$|fetch_[^/]+\.py$|review_thumbnails\.py$|add_depictions\.py$|_assets/|scripts/|start-atlas\.command$)' || true)"
# Lane A owns: numbered content folders + the auto-regenerated meta files.
# Regex widened 2026-05-19 from `^(0[1-9]_|1[0-7]_)` (16 lenses) to cover
# all 29 lenses (post ontology lock pass 3): 01-09, 10-19, 20-29.
LANE_A="$(printf '%s\n' "$STAGED_ALL" | grep -E '^(0[1-9]_|1[0-9]_|2[0-9]_)' || true)"

if [ -n "$LANE_B" ] && [ -n "$LANE_A" ]; then
  echo "" >&2
  echo "✗ pre-commit: cross-lane commit detected." >&2
  echo "" >&2
  echo "  Lane B (UX) paths in stage:" >&2
  printf '%s\n' "$LANE_B" | sed 's/^/    /' >&2
  echo "  Lane A (content) paths in stage:" >&2
  printf '%s\n' "$LANE_A" | sed 's/^/    /' >&2
  echo "" >&2
  echo "  These two lanes commit separately by design — content agents must not" >&2
  echo "  sweep app-code into their batches (twice killed the site 2026-05-15)." >&2
  echo "  See 00_meta/LANES.md." >&2
  echo "" >&2
  echo "  To split: unstage the wrong-lane paths and commit your own lane only." >&2
  echo "    git reset HEAD -- <wrong-lane-path>" >&2
  echo "" >&2
  echo "  Override (only if John explicitly authorised it):" >&2
  echo "    git commit --no-verify" >&2
  exit 1
fi

# Find any staged .js files under src/js/.
STAGED_JS="$(printf '%s\n' "$STAGED_ALL" | grep -E '^src/js/.+\.js$' || true)"

if [ -n "$STAGED_JS" ]; then
  # 1. Syntax check every staged JS file.
  if ! command -v node >/dev/null 2>&1; then
    NODE_BIN="$(ls ~/.local/node/bin/node 2>/dev/null || true)"
    if [ -z "$NODE_BIN" ]; then
      echo "✗ pre-commit: node binary not found. Cannot syntax-check JS." >&2
      echo "  Install node, or bypass once with: git commit --no-verify" >&2
      exit 1
    fi
  else
    NODE_BIN="node"
  fi

  FAILED=""
  for f in $STAGED_JS; do
    # Read the staged version (not the working tree — they can differ).
    # IMPORTANT: pipe via `git show` directly, NOT `echo "$STAGED_CONTENT"` —
    # /bin/sh's `echo` re-interprets backslash escapes (\n, \r, \a, …) in
    # the variable contents, corrupting any JS regex like /[^\n]/ into a
    # literal newline before the closing `]`. This produced a false-positive
    # "Invalid regular expression" failure the first time the hook was run
    # against src/js/alchemy/board.js (2026-05-15, sonnet-edges-v2).
    if ! git show ":$f" | "$NODE_BIN" --check - 2>/tmp/codex-precommit-err; then
      echo "" >&2
      echo "✗ SYNTAX ERROR in staged $f:" >&2
      sed 's/^/    /' /tmp/codex-precommit-err >&2
      FAILED="$FAILED $f"
    fi
  done

  if [ -n "$FAILED" ]; then
    echo "" >&2
    echo "✗ pre-commit: refusing to commit syntactically broken JavaScript." >&2
    echo "  Files:$FAILED" >&2
    echo "" >&2
    echo "  If this is a content batch and you didn't intend to edit app code:" >&2
    echo "    git checkout HEAD -- $FAILED" >&2
    echo "    git add ... (just your content files)" >&2
    echo "    git commit ..." >&2
    echo "" >&2
    echo "  If you really intend the JS change, fix the syntax and re-stage." >&2
    exit 1
  fi

  # 2. Sanity check on src/js/app.js — the canaries below are load-bearing
  #    blocks that have been deleted by parallel-agent commit sweeps before.
  #    If a staged app.js LACKS them, that's almost certainly a stale-revert.
  if printf '%s\n' "$STAGED_JS" | grep -q "^src/js/app.js$"; then
    MISSING=""
    for canary in "VIEWS.astrology" "VIEWS.pantheon" "VIEWS.transmission" "window.selectNode" "VIEWS.alchemy"; do
      # Pipe directly from `git show` — see note above re: /bin/sh `echo`
      # munging backslash escapes inside JS source held in shell variables.
      if ! git show :src/js/app.js | grep -q "$canary"; then
        MISSING="$MISSING $canary"
      fi
    done
    if [ -n "$MISSING" ]; then
      echo "" >&2
      echo "✗ pre-commit: staged src/js/app.js is missing load-bearing blocks:" >&2
      echo "   $MISSING" >&2
      echo "" >&2
      echo "  This looks like a stale-checkout sweep (a content batch committing" >&2
      echo "  an OLD app.js, deleting recent app-code work). Two such sweeps" >&2
      echo "  killed the site on 2026-05-15. Revert with:" >&2
      echo "    git checkout HEAD -- src/js/app.js" >&2
      echo "    git add ... (your real intended files)" >&2
      echo "" >&2
      echo "  If you genuinely meant to delete one of these blocks, bypass with" >&2
      echo "  --no-verify (after explicit confirmation from John)." >&2
      exit 1
    fi
  fi
fi

# ============================================================
# TYRANT Phase 2 (2026-05-25) — Lane A content gates.
# Run lint_yaml.py + linkcheck.py --baseline only when the commit
# touches content folders. Lane B (UX) commits skip these — they
# don't add/remove [[wikilinks]] or YAML schemas.
# ============================================================

# Resolve Python binary (same trick as node above — covers macOS
# where /usr/bin/python3 might not be the user's installed one).
if ! command -v python3 >/dev/null 2>&1; then
  PY_BIN="$(ls ~/.local/bin/python3 2>/dev/null || true)"
  if [ -z "$PY_BIN" ]; then
    # Quiet skip if python3 truly unavailable — don't break commits
    # that legitimately don't need it (e.g. pure src/js/ Lane B).
    PY_BIN=""
  fi
else
  PY_BIN="python3"
fi

# Only run content gates if there are staged Lane A paths.
if [ -n "$LANE_A" ] && [ -n "$PY_BIN" ]; then
  # ---------- 4. linkcheck baseline gate ----------
  # Refuses NEW dead [[wikilinks]] (regression vs the floor file).
  # Existing 593 dead targets are tolerated; only new ones fail.
  if ! "$PY_BIN" linkcheck.py --baseline >/tmp/codex-linkcheck-out 2>&1; then
    echo "" >&2
    echo "✗ pre-commit: WIRING LAW regression detected." >&2
    cat /tmp/codex-linkcheck-out | sed 's/^/    /' >&2
    echo "" >&2
    echo "  See HOW-WE-WORK.md §5.4 (cardinal rule #4): every [[wikilink]]" >&2
    echo "  must point to a real node before commit." >&2
    echo "  Baseline file: AUDIT/dead-link-baseline.txt" >&2
    exit 1
  fi

  # ---------- 5. lint_yaml strict gate ----------
  # Refuses ERROR-level schema issues (malformed frontmatter,
  # missing required field, unknown type). 29-type coverage.
  if ! "$PY_BIN" lint_yaml.py --strict --quiet >/tmp/codex-lint-out 2>&1; then
    echo "" >&2
    echo "✗ pre-commit: YAML schema lint failed." >&2
    cat /tmp/codex-lint-out | sed 's/^/    /' >&2
    echo "" >&2
    echo "  See 00_meta/lint-report.md for details." >&2
    exit 1
  fi

  # ---------- 6. dup-ID gate (pre-commit; was post-commit) ----------
  # Calls scripts/check_dup_ids.py — refuses if any staged .md
  # collides with another node's id. ATLAS_ALLOW_DUP_ID escape
  # hatch in build_data.py was deleted in TYRANT Phase 2.
  DUP_OUT="$("$PY_BIN" scripts/check_dup_ids.py 2>&1)"
  DUP_RC=$?
  if [ "$DUP_RC" -ne 0 ]; then
    echo "" >&2
    echo "✗ pre-commit: duplicate slug-ID across vault nodes." >&2
    printf '%s\n' "$DUP_OUT" | sed 's/^/    /' >&2
    echo "" >&2
    echo "  Two nodes with the same id silently overwrite each other in" >&2
    echo "  data.js (the loser disappears from the graph). Rename one file" >&2
    echo "  so the two have distinct slugs; link them via syncretic-edges" >&2
    echo "  if they conceptually overlap." >&2
    exit 1
  fi
fi

# ============================================================
# TYRANT Phase 6 (2026-05-25) — SOFT STATUS nudge.
# Warns (does NOT block) when a Lane B commit lands without
# touching 00_meta/STATUS.md. Closes the 52:1 ratio finding #8
# by surfacing the missing entry at commit time instead of after.
# Bypass: just continue committing — the warning is informational.
# ============================================================
if [ -n "$LANE_B" ]; then
  STAGED_STATUS="$(printf '%s\n' "$STAGED_ALL" | grep -E '^00_meta/STATUS\.md$' || true)"
  if [ -z "$STAGED_STATUS" ]; then
    echo "" >&2
    echo "ⓘ pre-commit (nudge): this Lane B commit does not touch" >&2
    echo "  00_meta/STATUS.md. HOW-WE-WORK §11 expects one batch" >&2
    echo "  entry per shipped batch. Commit will proceed; consider" >&2
    echo "  adding a STATUS entry in the next commit." >&2
    echo "" >&2
  fi
fi

exit 0
